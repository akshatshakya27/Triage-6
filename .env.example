SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///./triage6.db
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MODEL_PATH=model/lightgbm.txt
MODEL_MANIFEST=model/manifest.json
HIGH_RISK_THRESHOLD=0.85
WATSONX_ENABLED=false
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Empty keys = local development mode. Set all three distinct keys for role separation.
ADMIN_API_KEY=
ANALYST_API_KEY=
VIEWER_API_KEY=
DEMO_ENABLED=true

# Narrative provider: auto preserves existing IBM setting; template disables cloud calls.
# Choose mistral explicitly to send high-risk model/SHAP evidence to Mistral.
NARRATIVE_PROVIDER=auto
MISTRAL_API_KEY=
MISTRAL_MODEL_ID=mistral-large-latest
